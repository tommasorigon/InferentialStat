install.packages("betareg")
curve( 2* x + 2 * sqrt(x^2 - x), 0, 200)
curve( 2* x - 2 * sqrt(x^2 - x), 0, 200)
curve( 2* x - 2 * sqrt(x^2 - x), 1, 2000)
curve( 2* x - 2 * sqrt(x^2 - x), 5, 2000)
curve( 2* x - 2 * sqrt(x^2 - x), 10, 2000)
n <- 100
k <- 30
gamma <- function(mu){
2 * mu - (mu^2 - mu)
}
curve( (k^2 - k * gamma(x) + gamma(x)^2 / 4) / (n^2 + n * gamma(x) + gamma(x)^2 / 4), 1, 1000)
