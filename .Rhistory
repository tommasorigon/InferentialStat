PQ.augADMM <- logitADMM_PQ(y, X, A, lambda_graph,
gamma = gamma,
eps_target = eps_target, eps_surrogate = eps_surrogate,
itermax_out = 5000, itermax_in = 5000,
boost_init = F
)
time.PQ <- proc.time() - ptm
print(time.PQ)
beta.PQ <- PQ.augADMM$beta
fun.val.PQ <- logistic_loglik(y, X, beta.PQ, A, lambda_graph, gamma)
############ PQ boost ADMM #############
ptm <- proc.time()
PQboost.augADMM <- logitADMM_PQ(y, X, A, lambda_graph,
gamma = gamma,
eps_target = eps_target, eps_surrogate = eps_surrogate,
itermax_out = 5000, itermax_in = 5000
)
time.PQboost <- proc.time() - ptm
print(time.PQboost)
beta.PQboost <- PQboost.augADMM$beta
fun.val.PQboost <- logistic_loglik(y, X, beta.PQboost, A, lambda_graph, gamma)
