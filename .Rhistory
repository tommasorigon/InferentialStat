# Install required packages if not already installed
install.packages("circular")
install.packages("ggplot2")
install.packages("dplyr")
# Load libraries
library(circular)
library(ggplot2)
library(dplyr)
# Parameters
mu <- circular(0)      # mean direction in radians
kappa <- 2             # concentration parameter
n <- 1000              # number of samples
# Generate random samples from von Mises distribution
samples <- rvonmises(n = n, mu = mu, kappa = kappa)
# Convert to data frame
df <- data.frame(angle = as.numeric(samples))
# Bin the data for rose diagram
df <- df %>%
mutate(bin = cut(angle, breaks = seq(-pi, pi, length.out = 37), include.lowest = TRUE)) %>%
group_by(bin) %>%
summarise(count = n(),
angle = mean(as.numeric(sub("\\((.+),.*", "\\1", bin))))
# Convert angle to radians for plotting
df$angle <- as.numeric(as.character(df$angle))
# Plot rose diagram
ggplot(df, aes(x = angle, y = count)) +
geom_bar(stat = "identity", width = 0.15, fill = "skyblue", color = "black") +
coord_polar(start = 0, direction = 1) +
theme_minimal() +
labs(title = "Rose Diagram of von Mises Distribution",
x = "", y = "")
