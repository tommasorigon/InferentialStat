library(readr)
lidar <- read_table("~/Downloads/lidar.txt")
View(lidar)
plot(lidar)
plot(lidar, pch = 16)
ggplot(data = lidar, aes(x = "range", y = "logratio")) + geom_point()
library(ggplot2)
ggplot(data = lidar, aes(x = "range", y = "logratio")) + geom_point()
View(lidar)
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() geom_smooth()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() + geom_smooth()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() + geom_smooth(se = F) + theme_light()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() + geom_smooth(se = F, span = 0.2) + theme_light()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() + geom_smooth(se = F, span = 0.3) + theme_light()
ggplot(data = lidar, aes(x = `"range"`,
y = `"logratio"`)) + geom_point() + geom_smooth(se = F, span = 0.4) + theme_light()
