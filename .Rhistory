# Parameters
mu <- circular(0)  # mean direction in radians
kappa <- 2         # concentration parameter
# Generate a sequence of angles
theta <- seq(-pi, pi, length.out = 500)
theta_circ <- circular(theta)
# Evaluate the von Mises density
density_vals <- dvonmises(theta_circ, mu = mu, kappa = kappa)
# Evaluate the von Mises density
density_vals <- dvonmises(theta_circ, gamma = mu, tau = kappa)
# Base R polar plot (manual setup)
polar.plot <- function(theta, r, ...) {
plot(0, 0, type = "n", xlim = c(-1,1)*max(r), ylim = c(-1,1)*max(r), asp = 1, axes = FALSE, xlab = "", ylab = "", ...)
lines(r * cos(theta), r * sin(theta), col = "blue", lwd = 2)
symbols(0, 0, circles = max(r), inches = FALSE, add = TRUE, fg = "gray")
}
# Plot the density
polar.plot(theta, density_vals, main = "Von Mises Density (μ=0, κ=2)")
library(ggplot2)
library(circular)
# Parameters
mu <- circular(0)  # mean direction (radians)
kappa <- 2         # concentration parameter
n <- 1000          # number of samples
# Generate random samples from von Mises distribution
samples <- rvonmises(n = n, mu = mu, kappa = kappa)
# Convert samples to data frame for ggplot
df <- data.frame(angle = as.numeric(samples))
# Create a density estimate
ggplot(df, aes(x = angle)) +
geom_density(aes(y = ..scaled..), adjust = 0.5, fill = "skyblue", color = "blue", alpha = 0.6) +
coord_polar(start = 0) +  # Convert to polar coordinates
theme_minimal() +
labs(title = "Rose Diagram of von Mises Distribution", x = "", y = "") +
theme(axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank())
