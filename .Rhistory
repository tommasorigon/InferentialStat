# Chunk 6
y <- dataset$wind_dir / 360 * 2 * pi
s1 <- sum(sin(y))
s2 <- sum(cos(y))
# Estimate the concentration parameter
gamma <- atan2(s1, s2)
tau <- circular::A1inv(mean(cos(y - gamma)))
theta1 <- tau * sin(gamma)
theta2 <- tau * cos(gamma)
#library(circular)
dvonmises <- function(x, gamma, tau){
1/ (2 * pi * circular::A1(tau)) * exp(tau * cos(x - gamma))
}
dvonmises <- Vectorize(dvonmises, vectorize.args = "x")
x_seq <- seq(0, 2 * pi, length.out = 500)
plot(x_seq / (2 * pi) * 360, dvonmises(x_seq, gamma, tau), type = "l", xlab = "Degrees", ylab = "Density")
rug(y/ (2 * pi) * 360)
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq)
x_seq
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq/(2 * pi)* 360)
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq/(2 * pi)* 360, n_directions = 18)
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq/(2 * pi)* 360, n_directions = 24)
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq/(2 * pi)* 360, n_directions = 32)
clifro::windrose(speed = dvonmises(x_seq, gamma, tau), direction = x_seq/(2 * pi)* 360, n_directions = 28)
rvonmises(x_seq, gamma, tau)
circular::rvonmises(x_seq, gamma, tau)
circular::rvonmises(100, gamma, tau)
circular::rvonmises(10000, gamma, tau)
clifro::windrose(direction = circular::rvonmises(10000, gamma, tau)/(2 * pi)* 360, n_directions = 28)
clifro::windrose(speed = 1, direction = circular::rvonmises(10000, gamma, tau)/(2 * pi)* 360, n_directions = 28)
clifro::windrose(speed = rep(1, 10000), direction = circular::rvonmises(10000, gamma, tau)/(2 * pi)* 360, n_directions = 28)
sample(10000, dataset$`Wind speed`, replace = TRUE)
