sourceCpp("bound_coeff.cpp")
source("logit_augADMM_mod.R")
logistic_loglik <- function(Y, X, beta, A, lambda, gamma) {
beta <- matrix(beta, ncol = length(lambda))
eta <- X %*% beta
fun.val <- colSums(as.vector(Y) * eta - log(1 + exp(eta))) -
lambda * (colSums(abs(A %*% beta)) + gamma * colSums(abs(beta[-1, , drop = F])))
fun.val
}
############ LOAD DATA #############
X <- as.matrix(rare::data.dtm)
D <- as.matrix(rare::tree.matrix(rare::data.hc))
y <- 1 * (as.vector(rare::data.rating) > 4)
A <- D[, -c(1:ncol(X))]
col0 <- colSums(X) > 0
A <- A[col0, ]
X <- X[, col0]
col0 <- colSums(A) > 0
A <- A[, col0]
n <- length(y)
m <- nrow(A)
X0 <- X
X <- cbind(rep(1, n), X %*% A)
A <- cbind(rep(0, m), A)
p <- ncol(A)
#
n <- 100
p <- 3
set.seed(123)
y <- rbinom(n, size = 1, prob = 0.5)
X <- cbind(1, matrix(runif(n * (p-1)), n, p-1))
A <- matrix(runif(n * p), n, p)
############ HYPER-PARAM #############
gamma <- 10 # 1 #
num.of.grid <- 1e2
# lambda_graph <- exp(seq(0,-15,length.out=num.of.grid))
# lambda_graph <- sort(lambda_graph,decreasing=F)
lambda_graph <- 0.5
eps_target <- 1e-10
eps_surrogate <- 1e-10
############ NR ADMM #############
ptm <- proc.time()
NR.augADMM <- logitADMM_NR(y, X, A, lambda_graph,
gamma = gamma,
eps_target = eps_target, eps_surrogate = eps_surrogate,
itermax_out = 5000, itermax_in = 5000
)
time.NR <- proc.time() - ptm
print(time.NR)
beta.NR <- NR.augADMM$beta
fun.val.NR <- logistic_loglik(y, X, beta.NR, A, lambda_graph, gamma)
############ BL ADMM #############
ptm <- proc.time()
BL.augADMM <- logitADMM_BL(y, X, A, lambda_graph,
gamma = gamma,
eps_target = eps_target, eps_surrogate = eps_surrogate,
itermax_out = 5000, itermax_in = 5000
)
time.BL <- proc.time() - ptm
print(time.BL)
beta.BL <- BL.augADMM$beta
fun.val.BL <- logistic_loglik(y, X, beta.BL, A, lambda_graph, gamma)
############ PG ADMM #############
ptm <- proc.time()
